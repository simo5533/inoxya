# Configuration SQLite pour INOXYA BIJOUX
# Copiez ce contenu dans un fichier .env.local à la racine du projet

# ==================== SQLITE CONFIGURATION ====================
# Configuration de la base de données SQLite locale
DB_TYPE=sqlite
DB_PATH=./data/inoxya_bijoux.db

# ==================== APPLICATION CONFIGURATION ====================
# URL de base de l'application
NEXTAUTH_URL=http://localhost:3000

# Clé secrète pour les sessions (générez une nouvelle clé pour la production)
NEXTAUTH_SECRET=inoxya-bijoux-secret-key-2024-development

# Mode d'environnement
NODE_ENV=development

# ==================== DATABASE CONFIGURATION ====================
# Configuration de la base de données (optionnel - pour PostgreSQL local)
# DATABASE_URL=postgresql://inoxya_user:inoxya_password_2024@localhost:5432/inoxya_bijoux

# ==================== EMAIL CONFIGURATION (OPTIONNEL) ====================
# Configuration SMTP pour les notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ==================== NOTES ====================
# 1. Ce fichier utilise SQLite local (plus simple que PostgreSQL)
# 2. La base de données est stockée dans le fichier ./data/inoxya_bijoux.db
# 3. Aucune installation supplémentaire requise
# 4. Ne commitez jamais ce fichier dans Git (il est dans .gitignore)
#
# ==================== AVANTAGES SQLITE ====================
# ✅ Aucune installation requise
# ✅ Base de données dans un fichier local
# ✅ Parfait pour le développement
# ✅ Facile à sauvegarder (copier le fichier)
# ✅ Pas de serveur à démarrer
#
# ==================== MIGRATION VERS POSTGRESQL ====================
# Si vous voulez utiliser PostgreSQL en production :
# 1. Suivez le guide GUIDE_INSTALLATION_POSTGRESQL.md
# 2. Changez DB_TYPE=postgresql dans ce fichier
# 3. Ajoutez les variables DB_HOST, DB_PORT, etc.
