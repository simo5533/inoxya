{
  "name": "inoxya-bijoux",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "setup": "node scripts/setup-env.js",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:restart": "docker-compose restart",
    "db:logs": "docker-compose logs -f postgres",
    "db:setup": "docker-compose exec postgres psql -U inoxya_user -d inoxya_bijoux -f /docker-entrypoint-initdb.d/setup-local-database.sql",
    "db:test": "node scripts/test-db-connection.js",
    "test:crud": "npm run test:crud",
    "test:apis": "npm run test:apis",
    "test:all": "npm run test:crud && npm run test:apis",
    "db:verify": "npx tsx scripts/verify-postgres-connection.ts",
    "db:migrate": "npx tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:execute": "npx tsx scripts/migrate-sqlite-to-postgres.ts --execute",
    "db:seed": "npx tsx scripts/seed-postgres.ts",
    "verify:images": "npx tsx scripts/verify-images.ts",
    "verify:packs": "npx tsx scripts/verify-packs.ts",
    "verify:sqlite": "npx tsx scripts/verify-sqlite.ts",
    "verify:all": "npx tsx scripts/verify-all.ts",
    "verify:db": "npx tsx scripts/verify-db.ts",
    "db:import-products": "npx tsx scripts/import-products-from-json.ts",
    "db:clean-packs": "npx tsx scripts/clean-duplicate-packs.ts",
    "db:delete-demo": "npx tsx scripts/delete-demo-products.ts",
    "db:delete-demo:execute": "npx tsx scripts/delete-demo-products.ts --execute",
    "db:verify-deletion": "npx tsx scripts/verify-demo-deletion.ts",
    "db:diagnose-categories": "npx tsx scripts/diagnose-category-bug.ts",
    "db:normalize-categories": "npx tsx scripts/normalize-categories.ts",
    "db:normalize-categories:execute": "npx tsx scripts/normalize-categories.ts --execute",
    "test:category-filter": "npx tsx scripts/test-category-filter.ts",
    "db:backup": "node scripts/backup-database.js",
    "cleanup:demo": "npx tsx scripts/cleanup-demo-products-safe.ts",
    "cleanup:demo:execute": "npx tsx scripts/cleanup-demo-products-safe.ts --execute",
    "audit:complet": "npx tsx scripts/audit-complet.ts",
    "smoke:test": "npx tsx scripts/smoke-test.ts",
    "remove:demo": "npx tsx scripts/remove-demo-content-production.ts",
    "remove:demo:execute": "npx tsx scripts/remove-demo-content-production.ts --execute",
    "admin:create": "npx tsx scripts/create-admin-user.ts",
    "admin:sql": "node scripts/create-admin-sql.js",
    "admin:check": "node scripts/check-admin-user.js",
    "admin:execute": "powershell -ExecutionPolicy Bypass -File scripts/execute-admin-sql.ps1",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "db:check": "tsx scripts/check-db-content.ts",
    "smoke:catalog": "tsx scripts/smoke-catalog.ts",
    "db:fix-null-filters": "tsx scripts/fix-null-filters.ts",
    "check:better-sqlite3": "tsx scripts/check-better-sqlite3.ts",
    "db:find-no-stock": "tsx scripts/find-products-without-stock.ts",
    "db:list-all": "tsx scripts/list-all-products-and-packs.ts",
    "db:activate": "tsx scripts/activate-and-verify-database.ts",
    "test:db-to-page": "tsx scripts/test-db-to-page.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
