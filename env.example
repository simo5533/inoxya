# ============================================
# INOXYA BIJOUX - Variables d'Environnement
# ============================================
# 
# Instructions:
# 1. Copiez ce fichier vers .env.local
# 2. Remplissez les valeurs selon votre environnement
# 3. Ne commitez JAMAIS .env.local dans Git
#
# ============================================

# ==================== APPLICATION ====================
# URL publique du site (obligatoire en production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode d'environnement
NODE_ENV=development

# ==================== SÉCURITÉ ====================
# Clé secrète JWT (OBLIGATOIRE - minimum 32 caractères)
# Générer avec: openssl rand -base64 32
JWT_SECRET=votre-cle-secrete-minimum-32-caracteres-changez-en-production

# ==================== BASE DE DONNÉES ====================
# Production / Vercel : soit PostgreSQL (DATABASE_URL), soit Supabase (URL + clés ci‑dessous).
#
# Option A — Supabase (comme l’app Next.js — prioritaire si les trois sont définies)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=cle-service-role-serveur-uniquement

# Option B — PostgreSQL direct (local Docker ou hébergeur)
DATABASE_URL=postgresql://inoxya_user:inoxya_password_2024@localhost:5432/inoxya_bijoux

# OU variables séparées (scripts legacy) :
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=inoxya_bijoux
# DB_USER=inoxya_user
# DB_PASSWORD=inoxya_password_2024

# Option C — SQLite (Développement uniquement — non supporté sur Vercel)
# Aucune configuration requise, la base sera créée dans data/inoxya_bijoux.db
# 
# PHASE B: Pour forcer un chemin absolu spécifique (recommandé en production):
# SQLITE_DB_PATH=C:\Users\Basma\Desktop\inoxya-bijoux 2\data\inoxya_bijoux.db

# ==================== EMAIL (OPTIONNEL) ====================
# Configuration SMTP pour les notifications email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@inoxya-bijoux.com

# ==================== VERCEL (OPTIONNEL) ====================
# VERCEL=1 est injecté automatiquement par Vercel
# Stockage fichiers (uploads admin) — créer un store Blob sur Vercel si besoin
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Rate limiting (optionnel, recommandé en prod)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ==================== FALLBACK & DEMO (DÉVELOPPEMENT UNIQUEMENT) ====================
# ⚠️  IMPORTANT: Ces flags sont IGNORÉS en production (NODE_ENV=production)
# 
# Activer le fallback depuis les images si DB vide/inaccessible (DEV UNIQUEMENT)
# En production, fallback JAMAIS activé même si ENABLE_FALLBACK=1
# Valeurs: 0 (désactivé) ou 1 (activé en dev uniquement)
ENABLE_FALLBACK=0

# Activer le seed de données demo au démarrage (DEV UNIQUEMENT)
# En production, seed JAMAIS activé même si ENABLE_DEMO_SEED=1
# Valeurs: 0 (désactivé) ou 1 (activé en dev uniquement)
ENABLE_DEMO_SEED=0

# ==================== NOTES ====================
# 
# DÉVELOPPEMENT:
# - Utilisez SQLite (aucune config requise)
# - JWT_SECRET peut être une valeur simple pour le dev
# - NEXT_PUBLIC_SITE_URL=http://localhost:3000
# - ENABLE_FALLBACK=1 (optionnel, pour tester sans DB)
# - ENABLE_DEMO_SEED=1 (optionnel, pour insérer des données demo)
#
# PRODUCTION:
# - Utilisez PostgreSQL (Supabase, Railway, etc.)
# - JWT_SECRET doit être unique et sécurisé (64+ caractères recommandé)
# - NEXT_PUBLIC_SITE_URL=https://votredomaine.com
# - NODE_ENV=production
# - ENABLE_FALLBACK=0 (ou non défini, fallback jamais activé en prod)
# - ENABLE_DEMO_SEED=0 (ou non défini, seed jamais activé en prod)
#
# SÉCURITÉ:
# - Ne jamais commiter ce fichier avec des valeurs réelles
# - Utiliser les variables d'environnement de votre plateforme de déploiement
# - Générer un nouveau JWT_SECRET pour chaque environnement
#
# ==================== EXEMPLE PRODUCTION ====================
# NODE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://inoxya-bijoux.com
# JWT_SECRET=<généré-avec-openssl-rand-base64-32>
# DATABASE_URL=postgresql://user:password@host:5432/database
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@inoxya-bijoux.com
# SMTP_PASS=<app-password>
# ADMIN_EMAIL=admin@inoxya-bijoux.com
