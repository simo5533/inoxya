# Configuration Base de Données INOXYA BIJOUX
# Copiez ce fichier vers .env.local et ajustez selon vos besoins

# ==================== BASE DE DONNÉES ====================
# Utiliser la base de données locale (SQLite) en développement
USE_LOCAL_DB=true

# Configuration Supabase (pour la production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==================== AUTHENTIFICATION ====================
# Clé secrète pour les cookies de session
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ==================== ENVIRONNEMENT ====================
# Mode de développement
NODE_ENV=development

# ==================== OPTIONNEL ====================
# Configuration email (pour les notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Configuration de base de données PostgreSQL (si vous voulez utiliser PostgreSQL au lieu de SQLite)
# DATABASE_URL=postgresql://inoxya_user:inoxya_password_2024@localhost:5432/inoxya_bijoux
