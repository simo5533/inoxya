# Copier vers .env.local : cp env.local.example .env.local (ou copie manuelle)
# Ne jamais commiter .env.local

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Sécurité (JWT sessions / API) — min. 32 caractères ; générer : openssl rand -base64 32 ---
JWT_SECRET=remplacer-par-une-cle-secrete-d-au-moins-32-caracteres

# --- Supabase (recommandé prod / Vercel) — URL + clé anon (publique) + service role (serveur uniquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-public
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-jamais-cote-client

# --- OU PostgreSQL direct (sans passer par l’adapter Supabase) ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Optionnel : Vercel Blob (uploads) ---
# BLOB_READ_WRITE_TOKEN=

# --- Optionnel : rate limiting distribué ---
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Optionnel : emails ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=
