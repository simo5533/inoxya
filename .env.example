# ===========================================
# INOXYA BIJOUX - Variables d'environnement
# Copier vers .env.local et remplir les valeurs.
# En production (Vercel) : ajouter dans Dashboard → Settings → Environment Variables.
# ===========================================

# --- OBLIGATOIRE (production) ---
# Clé JWT pour les sessions (min. 32 caractères). Générer une clé forte en production.
JWT_SECRET=your-secret-key-minimum-32-characters-long

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données (Vercel : Supabase ou Postgres requis) ---
# Option 1 - Supabase (recommandé pour Vercel) : priorité si les deux sont définis
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Option 2 - PostgreSQL (connexion directe)
# DATABASE_URL=postgresql://user:password@host:5432/database

# --- Optionnel ---
NODE_ENV=development

# Email (optionnel, pour factures / notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=admin@example.com

# Debug (ne pas activer en production)
# DEBUG_DB=0
# ENABLE_FALLBACK=0
