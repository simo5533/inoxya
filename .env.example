# ===========================================
# INOXYA BIJOUX - Variables d'environnement
# Copier vers .env.local et remplir les valeurs.
# En production (Vercel) : ajouter dans Dashboard > Settings > Environment Variables.
# ===========================================

# App
NEXT_PUBLIC_SITE_URL=https://inoxya.ma
NODE_ENV=production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Schéma (npm run db:supabase:apply-schema) : URI copiée telle quelle, ou mot de passe base + URL ci-dessus
SUPABASE_APPLY_CONNECTION_STRING=
SUPABASE_DB_PASSWORD=

# Auth
JWT_SECRET=

# Email (optionnel)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# SMS / Twilio (optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_MINUTES=10

# Redis (optionnel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring (optionnel)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optionnel avancé
DATABASE_URL=
NEON_DATABASE_URL=
VERCEL=
VERCEL_URL=
PORT=3000
NEXT_PUBLIC_PORT=3000
NEXT_PHASE=
BLOB_READ_WRITE_TOKEN=
# OIDC Vercel Blob (auto si store connecté au projet) :
BLOB_STORE_ID=
# private = store Vercel Blob privé (défaut) ; public = mettre "public" si le store est créé en accès public
BLOB_STORE_ACCESS=private
USE_STRUCTURED_LOGS=false
SQLITE_DB_PATH=
FORCE_SQLJS=0
SKIP_BETTER_SQLITE3=0
DEBUG_DB=0
ENABLE_FALLBACK=0
CHECKOUT_DEBUG=false
