# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
dist/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.env
.env.production
.env.staging
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database files
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/

# logs
logs/
*.log
temp-uploads/

# OS
.DS_Store
Thumbs.db

# coverage
coverage/

# SSL Certificates (ne pas commiter les certificats)
/certs/*.pem
/certs/*.key
/certs/*.crt
/certs/*.conf
!certs/.gitkeep
# Fichiers d'environnement locaux
.env.local
.env*.local

.vercel

# Documentation temporaire (ne pas commiter)
ANALYSE_*.md
BUGS_*.md
CORRECTION_*.md
DIAGNOSTIC_*.md
FIX_*.md
GUIDE_*.md
INSTRUCTIONS_*.md
NOTE_*.md
OPTIMISATIONS_*.md
PHASE_*.md
PROJET_*.md
RAPPORT_*.md
RESUME_*.md
SOLUTION_*.md
VERIFICATION_*.md
middleware.ts.*
middleware.backup.ts
*.old

.vercel
